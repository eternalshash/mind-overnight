[Unit]
Description=ECE 441 Smart HVAC Raspberry Pi 5 Edge Server (HTTP + SQLite + MQTT Bridge)
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/SmartHVAC_Sim
ExecStart=/usr/bin/python3 -m rpi_server.edge_server --host 0.0.0.0 --port 8765
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
